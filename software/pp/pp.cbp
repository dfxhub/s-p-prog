<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="pp" />
		<Option pch_mode="2" />
		<Option compiler="cygwin" />
		<Build>
			<Target title="Release">
				<Option output="bin/Release/pp" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="cygwin" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
			</Target>
		</Build>
		<Linker>
			<Add option="-O2" />
		</Linker>
		<ExtraCommands>
			<Add after="strip $(TARGET_OUTPUT_FILE)" />
			<Mode after="always" />
		</ExtraCommands>
		<Unit filename="pp3.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="pp_globals.h" />
		<Unit filename="pp_progtools.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="pp_progtools.h" />
		<Unit filename="pp_serial.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="pp_serial.h" />
		<Unit filename="pp_utils.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="pp_utils.h" />
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
